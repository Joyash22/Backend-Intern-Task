# ---- Service ----
APP_ENV=development
# dev=5200, stage=5201, prod=5202
SERVICE_PORT=5200
# optional; if set, clients must send X-API-Key. Leave empty to disable.
SERVICE_API_KEY=

# ---- HubSpot (NEVER commit the real token; it is sent per scan request) ----
HUBSPOT_BASE_URL=https://api.hubapi.com
HUBSPOT_TIMEOUT_SECONDS=30
HUBSPOT_PAGE_SIZE=100
HUBSPOT_MAX_RETRIES=5
HUBSPOT_RATE_LIMIT_REQUESTS=150
HUBSPOT_RATE_LIMIT_WINDOW_SECONDS=10

# ---- Pipeline ----
PIPELINE_NAME=hubspot_deals
DATASET_SCHEMA=hubspot_deals
CHECKPOINT_EVERY_N_PAGES=5
PIPELINES_DIR=/app/.pipelines

# ---- Destination (development credentials) ----
# postgres | duckdb
DESTINATION=postgres
POSTGRES_USER=dlt_user
POSTGRES_PASSWORD=dlt_password
POSTGRES_DB=hubspot_etl
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# used when DESTINATION=duckdb
# DUCKDB_PATH=./data/hubspot.duckdb
